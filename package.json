{
  "name": "webrad",
  "productName": "WebRad",
  "version": "0.1.12",
  "private": true,
  "description": "A visual RAD IDE for modern web applications",
  "main": ".vite/build/main.js",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --max-old-space-size=4096 ./node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "dev": "node --max-old-space-size=4096 ./node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "typecheck": "tsc --noEmit",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-app-icons.mjs",
    "icons:check": "node scripts/generate-app-icons.mjs --check",
    "runtime:sources": "node scripts/sync-runtime-sources.mjs",
    "runtime:sources:check": "node scripts/sync-runtime-sources.mjs --check",
    "test": "vitest run",
    "test:portable": "node scripts/test-portability.mjs",
    "test:watch": "vitest",
    "build": "node --max-old-space-size=4096 ./node_modules/@electron-forge/cli/dist/electron-forge.js package",
    "package": "node --max-old-space-size=4096 ./node_modules/@electron-forge/cli/dist/electron-forge.js package",
    "make": "node --max-old-space-size=4096 ./node_modules/@electron-forge/cli/dist/electron-forge.js make",
    "release": "npm run make",
    "smoke:development": "node scripts/smoke-development.mjs",
    "smoke:debugger": "node scripts/smoke-development.mjs --webrad-smoke-debugger",
    "smoke:resources": "node scripts/smoke-packaged.mjs --webrad-smoke-resources",
    "smoke:report-builder": "node scripts/smoke-report-builder.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:viewport": "node scripts/smoke-native-viewport.mjs",
    "validate": "npm run icons:check && npm run runtime:sources:check && npm run typecheck && npm run lint && npm run test:portable && npm run format:check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@monaco-editor/react": "4.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "electron-squirrel-startup": "1.0.1",
    "esbuild": "0.28.2",
    "monaco-editor": "0.56.0",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.8.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript-eslint": "8.67.0",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "yauzl": "3.4.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atentor/WebRad.git"
  },
  "homepage": "https://webrad.atentor.com",
  "bugs": {
    "url": "https://github.com/Atentor/WebRad/issues"
  }
}
