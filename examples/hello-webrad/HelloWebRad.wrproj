{
  "formatVersion": 2,
  "id": "hello-webrad-project-v1",
  "name": "HelloWebRad",
  "entryPage": "hello-webrad-form-main-v1",
  "pages": [
    {
      "id": "hello-webrad-form-main-v1",
      "name": "index",
      "pageFile": "pages/index.wrpage",
      "generatedFile": "pages/index.generated.ts",
      "codeFile": "pages/index.ts"
    },
    {
      "id": "hello-webrad-project-v1:404:page",
      "name": "404",
      "pageFile": "pages/404.wrpage",
      "generatedFile": "pages/404.generated.ts",
      "codeFile": "pages/404.ts"
    }
  ],
  "reusableElements": [],
  "styles": [
    {
      "id": "hello-webrad-project-v1:default-style:WebToggle",
      "name": "Default Toggle",
      "componentType": "WebToggle",
      "preset": "default",
      "states": {
        "base": {
          "backgroundGradient": {
            "kind": "linear",
            "direction": "to-bottom",
            "from": "#e2e8f0",
            "to": "#cbd5e1"
          },
          "borderGradient": {
            "kind": "linear",
            "direction": "to-bottom-right",
            "from": "#bfdbfe",
            "to": "#ddd6fe"
          },
          "borderRadius": {
            "value": 6,
            "unit": "px"
          },
          "borderStyle": "solid",
          "borderWidth": {
            "value": 1,
            "unit": "px"
          },
          "boxShadow": "sm",
          "cursor": "pointer",
          "fontFamily": "roboto",
          "toggleCheckedColor": "var(--wr-palette-aurora-blue)",
          "toggleThumbColor": "var(--wr-palette-aurora-white)",
          "transitionDuration": 200,
          "transitionProperty": "all",
          "transitionTimingFunction": "easeOut"
        },
        "hover": {
          "boxShadow": "md"
        },
        "focus": {
          "ringColor": "#93c5fd",
          "ringOffsetColor": "var(--wr-palette-aurora-white)",
          "ringOffsetWidth": {
            "value": 2,
            "unit": "px"
          },
          "ringWidth": {
            "value": 2,
            "unit": "px"
          }
        },
        "active": {
          "boxShadow": "none"
        },
        "disabled": {
          "boxShadow": "none",
          "cursor": "not-allowed",
          "opacity": 60,
          "toggleCheckedColor": "#94a3b8",
          "toggleThumbColor": "#f1f5f9"
        }
      }
    },
    {
      "id": "hello-webrad-project-v1:default-style:WebProgressBar",
      "name": "Default ProgressBar",
      "componentType": "WebProgressBar",
      "preset": "default",
      "states": {
        "base": {
          "backgroundGradient": {
            "kind": "linear",
            "direction": "to-bottom",
            "from": "var(--wr-palette-aurora-white)",
            "to": "var(--wr-palette-aurora-surface)"
          },
          "borderGradient": {
            "kind": "linear",
            "direction": "to-bottom-right",
            "from": "#bfdbfe",
            "to": "#ddd6fe"
          },
          "borderRadius": {
            "value": 6,
            "unit": "px"
          },
          "borderStyle": "solid",
          "borderWidth": {
            "value": 1,
            "unit": "px"
          },
          "fontFamily": "roboto",
          "fontSize": {
            "value": 12,
            "unit": "px"
          },
          "fontWeight": "semibold",
          "progressColor": "var(--wr-palette-aurora-blue)",
          "progressThickness": 8,
          "progressTrackColor": "#e2e8f0",
          "textColor": "var(--wr-palette-aurora-ink)"
        },
        "hover": {},
        "focus": {},
        "active": {},
        "disabled": {
          "opacity": 60,
          "progressColor": "#94a3b8"
        }
      }
    },
    {
      "id": "hello-webrad-project-v1:default-style:WebIcon",
      "name": "Default Icons",
      "componentType": "WebIcon",
      "preset": "default",
      "states": {
        "base": {
          "borderRadius": {
            "value": 4,
            "unit": "px"
          },
          "borderWidth": {
            "value": 0,
            "unit": "px"
          },
          "fontFamily": "roboto",
          "textColor": "var(--wr-palette-aurora-blue)"
        },
        "hover": {},
        "focus": {},
        "active": {},
        "disabled": {
          "cursor": "not-allowed",
          "opacity": 60
        }
      }
    },
    {
      "id": "hello-webrad-project-v1:default-style:WebMenu",
      "name": "Default Menu",
      "componentType": "WebMenu",
      "preset": "default",
      "states": {
        "base": {
          "borderRadius": {
            "value": 16,
            "unit": "px"
          },
          "borderWidth": {
            "value": 0,
            "unit": "px"
          },
          "boxShadow": "none",
          "fontFamily": "roboto"
        },
        "hover": {},
        "focus": {},
        "active": {},
        "disabled": {
          "opacity": 60
        }
      }
    },
    {
      "id": "hello-webrad-project-v1:default-style:WebRepeatingGroup",
      "name": "Default Repeating Group",
      "componentType": "WebRepeatingGroup",
      "preset": "default",
      "states": {
        "base": {
          "backgroundColor": "var(--wr-palette-aurora-white)",
          "borderColor": "#cbd5e1",
          "borderRadius": {
            "value": 6,
            "unit": "px"
          },
          "borderStyle": "solid",
          "borderWidth": {
            "value": 1,
            "unit": "px"
          },
          "fontFamily": "roboto",
          "fontSize": {
            "value": 14,
            "unit": "px"
          },
          "textColor": "var(--wr-palette-aurora-graphite)"
        },
        "hover": {},
        "focus": {},
        "active": {},
        "disabled": {}
      }
    },
    {
      "id": "hello-webrad-project-v1:default-style:WebVideoPlayer",
      "name": "Default Video Player",
      "componentType": "WebVideoPlayer",
      "preset": "default",
      "states": {
        "base": {
          "backgroundGradient": {
            "kind": "linear",
            "direction": "to-bottom",
            "from": "var(--wr-palette-aurora-graphite)",
            "to": "var(--wr-palette-aurora-ink)"
          },
          "borderGradient": {
            "kind": "linear",
            "direction": "to-bottom-right",
            "from": "var(--wr-palette-aurora-sky)",
            "to": "var(--wr-palette-aurora-lavender)"
          },
          "borderRadius": {
            "value": 6,
            "unit": "px"
          },
          "borderStyle": "solid",
          "borderWidth": {
            "value": 1,
            "unit": "px"
          },
          "boxShadow": "sm",
          "fontFamily": "roboto",
          "objectFit": "contain",
          "objectPosition": "center",
          "textColor": "var(--wr-palette-aurora-white)",
          "transitionDuration": 200,
          "transitionProperty": "shadow",
          "transitionTimingFunction": "easeOut"
        },
        "hover": {
          "boxShadow": "md"
        },
        "focus": {
          "boxShadow": "md",
          "ringColor": "var(--wr-palette-aurora-sky)",
          "ringOffsetColor": "var(--wr-palette-aurora-white)",
          "ringOffsetWidth": {
            "value": 2,
            "unit": "px"
          },
          "ringWidth": {
            "value": 2,
            "unit": "px"
          }
        },
        "active": {},
        "disabled": {
          "boxShadow": "none",
          "opacity": 60
        }
      }
    },
    {
      "id": "hello-webrad-project-v1:default-style:WebPopup",
      "name": "Default Popup",
      "componentType": "WebPopup",
      "preset": "default",
      "states": {
        "base": {
          "backgroundGradient": {
            "kind": "linear",
            "direction": "to-bottom",
            "from": "#ffffff",
            "to": "#f8fafc"
          },
          "borderGradient": {
            "kind": "linear",
            "direction": "to-bottom-right",
            "from": "#dbeafe",
            "to": "#e9d5ff"
          },
          "borderRadius": {
            "value": 6,
            "unit": "px"
          },
          "borderStyle": "solid",
          "borderWidth": {
            "value": 1,
            "unit": "px"
          },
          "boxShadow": "md",
          "fontFamily": "roboto",
          "textColor": "#0f172a",
          "transitionDuration": 200,
          "transitionProperty": "all",
          "transitionTimingFunction": "easeOut"
        },
        "hover": {},
        "focus": {},
        "active": {},
        "disabled": {}
      }
    },
    {
      "id": "hello-webrad-style-button-primary-v1",
      "name": "PrimaryButton",
      "componentType": "WebButton",
      "states": {
        "base": {
          "backgroundColor": "#0284c7",
          "borderColor": "transparent",
          "borderRadius": "lg",
          "boxShadow": "md",
          "fontWeight": "medium",
          "textColor": "#ffffff",
          "transitionDuration": 200,
          "transitionProperty": "all",
          "transitionTimingFunction": "easeOut",
          "userSelect": "none"
        },
        "hover": {
          "backgroundColor": "#0369a1",
          "boxShadow": "lg",
          "translateY": {
            "value": -2,
            "unit": "px"
          }
        },
        "focus": {
          "outlineStyle": "none",
          "ringColor": "#38bdf8",
          "ringOffsetWidth": {
            "value": 2,
            "unit": "px"
          },
          "ringWidth": {
            "value": 2,
            "unit": "px"
          }
        },
        "active": {
          "scale": 95,
          "translateY": {
            "value": 0,
            "unit": "px"
          }
        },
        "disabled": {
          "cursor": "not-allowed",
          "opacity": 50
        }
      }
    }
  ],
  "settings": {
